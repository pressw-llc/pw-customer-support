# Host port for Postgres
SUPPORT_POSTGRES_PORT=5447
# Host port for LocalStack
SUPPORT_LOCALSTACK_PORT=4577
AWS_REGION=us-east-1
# LocalStack dummy credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
ATTACHMENTS_BUCKET=pw-support-attachments
TRIAGE_WAKE_QUEUE=pw-support-triage-wake
TRIAGE_WAKE_DLQ=pw-support-triage-wake-dlq
# Hono API server port
API_PORT=8787
# Secrets: set with bun run env set NAME --secret --stdin
ANTHROPIC_API_KEY=
# TypeSafe Jev key
TYPESAFE_API_KEY=
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
# Cognito token issuer URL
COGNITO_ISSUER=
COGNITO_AUDIENCE=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_KEY=
RATE_LIMIT_PER_USER=120
SEED_CLIENT_SLUG=acme
SEED_PROJECT_SLUG=portal
SUPPORT_API_URL=http://localhost:8787
MAX_REQUEST_BYTES=
SEED_PROJECT_KEY=
VITE_SUPPORT_PROJECT_KEY=
VITE_SUPPORT_USER_EMAIL=
VITE_SUPPORT_API_URL=
# Initial cloud triage delay per channel
TRIAGE_INITIAL_DELAY_SECONDS=60
# Claim lease length
TRIAGE_LEASE_SECONDS=120
# Attempts before human triage
TRIAGE_MAX_ATTEMPTS=3
# Wait for attachment storage before a job is claimable
TRIAGE_INTAKE_GRACE_SECONDS=300
# Worker sweep interval
TRIAGE_SWEEP_INTERVAL_SECONDS=30
# Managed agent model
TRIAGE_AGENT_MODEL=claude-sonnet-5-5
# Managed agent id, overrides the lock file
TRIAGE_AGENT_ID=
# Agent session timeout
TRIAGE_AGENT_TIMEOUT_SECONDS=240
# Worker claimant name
TRIAGE_WORKER_ID=
# Extracted text cap per file
TRIAGE_MAX_CHARS_PER_FILE=20000
# Extracted text cap per request
TRIAGE_MAX_CHARS_TOTAL=60000
# Images sent to the agent
TRIAGE_MAX_IMAGES=6
# Injection flag threshold
JEV_INJECTION_THRESHOLD=0.5
# Jev request timeout
JEV_TIMEOUT_MS=15000
# Characters per Jev judgment
JEV_CHUNK_CHARS=4000
# Judge images with Jev
JEV_JUDGE_IMAGES=1
# Linear GraphQL URL, blank for the real API
LINEAR_API_URL=
# Linear team for the live test
LINEAR_TEST_TEAM_ID=
# Local Linear stub port
LINEAR_STUB_PORT=4590
# Phase 2 validation wait scale
VALIDATE_TIME_FACTOR=1
# seed:settings Linear team id
SEED_LINEAR_TEAM_ID=
# Host port for the mock OIDC issuer
SUPPORT_OIDC_PORT=4599
# Admin Vite dev server port
ADMIN_DEV_PORT=5183
# Comma list of browser origins allowed by admin CORS
ADMIN_ORIGINS=
# Optional comma list of staff email domains
ADMIN_ALLOWED_EMAIL_DOMAINS=
# Optional Cognito group a staff token must carry
ADMIN_REQUIRED_GROUP=
# Admin request body cap
ADMIN_MAX_BODY_BYTES=16384
# Admin mutations per window per staff member
ADMIN_RATE_LIMIT_PER_WINDOW=60
# Timeout for issuer discovery and JWKS fetches
AUTH_FETCH_TIMEOUT_MS=5000
# Secrets Manager scope under the secrets prefix
SECRETS_SCOPE=global
# Admin app API base URL
VITE_API_URL=
# Admin app OIDC issuer URL
VITE_OIDC_AUTHORITY=
# Admin app OIDC client id
VITE_OIDC_CLIENT_ID=
# Admin app OIDC scopes, default openid profile email
VITE_OIDC_SCOPE=
# API port for validate:phase-4
VALIDATE_API_PORT=8796
# Admin app port for the e2e suite
E2E_ADMIN_PORT=5184
# Comma list of client ids the MCP route accepts, falls back to COGNITO_AUDIENCE
MCP_AUDIENCE=
# MCP requests per window per engineer
MCP_RATE_LIMIT_PER_WINDOW=120
# Body cap for MCP requests
MCP_MAX_BODY_BYTES=262144
# Laptop plugin: API base URL
PW_SUPPORT_API_URL=http://127.0.0.1:8787
# Laptop plugin: token issuer URL, mock issuer when blank
PW_SUPPORT_ISSUER=
# Laptop plugin: OAuth client id
PW_SUPPORT_CLIENT_ID=pw-support-mcp
# Laptop plugin: client secret for the non-interactive grant
PW_SUPPORT_CLIENT_SECRET=
# Laptop plugin: OAuth scope
PW_SUPPORT_SCOPE=
# Laptop plugin: loopback port for login
PW_SUPPORT_LOGIN_PORT=53682
# Laptop plugin: token and watcher state directory
PW_SUPPORT_CONFIG_DIR=
# Laptop plugin: model for the headless subagent
PW_SUPPORT_MODEL=
# Laptop plugin: claude executable
PW_SUPPORT_CLAUDE_BIN=claude
# Laptop plugin: watcher poll interval
PW_SUPPORT_POLL_SECONDS=10
# Laptop plugin: hard timeout for one subagent run
PW_SUPPORT_RUN_TIMEOUT_SECONDS=90
# Laptop plugin: spend cap for one subagent run
PW_SUPPORT_MAX_BUDGET_USD=0.5
# Laptop plugin: turn cap for one subagent run
PW_SUPPORT_MAX_TURNS=3
# Laptop plugin: directory for redacted subagent run reports
PW_SUPPORT_RUN_REPORT_DIR=
