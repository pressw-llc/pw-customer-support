{
  "name": "pw-customer-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "modules/*",
    "apps/*",
    "examples/*",
    "e2e"
  ],
  "scripts": {
    "check": "bun scripts/check.ts",
    "build": "bun run --filter @pressw-llc/support-react build && bun run --filter @pw-support/admin build",
    "lint": "biome check . && bun scripts/lint-boundaries.ts",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "test": "bun test --coverage --path-ignore-patterns 'modules/widget/**' --path-ignore-patterns 'e2e/**' --path-ignore-patterns 'examples/**' && bun run --filter @pressw-llc/support-react test",
    "e2e": "bun run --filter @pw-support/e2e test",
    "stack:up": "bun scripts/stack.ts up",
    "stack:down": "bun scripts/stack.ts down",
    "stack:setup": "bun scripts/stack-setup.ts",
    "env": "bun scripts/env.ts",
    "validate:phase-1": "bun scripts/validate/phase-1-smoke.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "seed:dev": "bun scripts/seed-dev.ts",
    "dev:api": "bun scripts/db-migrate.ts && bun scripts/stack-setup.ts && bun apps/server/src/server.ts",
    "dev:example": "bun run --filter @pw-support/host-app dev",
    "dev:admin": "bun scripts/dev-admin.ts",
    "dev:worker": "bun scripts/db-migrate.ts && bun scripts/stack-setup.ts && bun scripts/dev-worker.ts",
    "dev:linear-stub": "bun scripts/dev-linear-stub.ts",
    "agent:sync": "bun modules/triage/agents/support-triage/sync.ts",
    "seed:settings": "bun scripts/seed-settings.ts",
    "validate:pipelines": "bunx pw-pipeline validate",
    "validate:phase-2": "bun scripts/validate/phase-2-live.ts",
    "validate:phase-3": "bun scripts/validate/phase-3-live.ts",
    "validate:phase-4": "bun scripts/validate/phase-4-live.ts",
    "validate:phase-5": "bun scripts/validate/phase-5-live.ts",
    "synth": "bun run --filter @pw-support/infra synth",
    "prepare": "git config core.hooksPath .githooks || true",
    "release": "bun scripts/release.ts",
    "demo": "bun scripts/demo.ts",
    "deploy": "bun scripts/deploy.ts",
    "smoke": "bun scripts/smoke.ts",
    "build:plugin": "bun scripts/build-plugin.ts",
    "validate:release": "bun scripts/validate/phase-6-release.ts",
    "validate:deploy": "bun scripts/validate/phase-6-deploy.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@aws-sdk/client-cloudformation": "^3.717.0",
    "@aws-sdk/client-ecs": "^3.717.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/client-secrets-manager": "^3.717.0",
    "@aws-sdk/client-sqs": "^3.717.0",
    "@aws-sdk/client-sts": "^3.717.0",
    "@biomejs/biome": "2.6.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.65.1",
    "@pressw-llc/managed-agents": "0.5.0",
    "@pressw-llc/pipeline": "0.3.0",
    "@pw-support/api": "workspace:*",
    "@pw-support/channels": "workspace:*",
    "@pw-support/contracts": "workspace:*",
    "@pw-support/db": "workspace:*",
    "@pw-support/infra": "workspace:*",
    "@pw-support/plugin": "workspace:*",
    "@pw-support/triage": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.36.4",
    "jose": "6.2.3",
    "typescript": "~5.7.2",
    "zod": "^3.24.1"
  }
}
