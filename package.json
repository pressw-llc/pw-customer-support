{
  "name": "pw-customer-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "check": "bun scripts/check.ts",
    "lint": "biome check . && bun scripts/lint-boundaries.ts",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "test": "bun test --coverage",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down -v",
    "db:migrate": "bun scripts/db-migrate.ts",
    "env": "bun scripts/env.ts",
    "synth": "bun run --filter @pw-support/infra synth",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/client-sqs": "^3.717.0",
    "@biomejs/biome": "2.6.2",
    "@pw-support/contracts": "workspace:*",
    "@pw-support/db": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "typescript": "~5.7.2"
  }
}
